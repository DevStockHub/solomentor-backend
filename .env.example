# App
APP_NAME=Solomentor Backend
DEBUG=false

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/solomentor

# OpenRouter
OPENROUTER_API_KEY=your api key here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# AI Models (primary + 3 secondaries) - Current free OpenRouter models as of Oct 2026
AI_PRIMARY_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
AI_SECONDARY_MODELS_CSV=nvidia/nemotron-3.5-lightning:free,poolside/laguna-s-2.1:free,cohere/north-mini-code:free